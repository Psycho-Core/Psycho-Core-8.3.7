	cd /home/user/BfaCore-Reforged/configure-test && $(MAKE) $(MAKESILENT) -f src/server/game/CMakeFiles/game.dir/build.make src/server/game/CMakeFiles/game.dir/World/World.cpp.o
.PHONY : World/World.cpp.o

World/World.i: World/World.cpp.i
.PHONY : World/World.i

# target to preprocess a source file
World/World.cpp.i:
	cd /home/user/BfaCore-Reforged/configure-test && $(MAKE) $(MAKESILENT) -f src/server/game/CMakeFiles/game.dir/build.make src/server/game/CMakeFiles/game.dir/World/World.cpp.i
.PHONY : World/World.cpp.i

World/World.s: World/World.cpp.s
.PHONY : World/World.s

# target to generate assembly for a file
World/World.cpp.s:
	cd /home/user/BfaCore-Reforged/configure-test && $(MAKE) $(MAKESILENT) -f src/server/game/CMakeFiles/game.dir/build.make src/server/game/CMakeFiles/game.dir/World/World.cpp.s
.PHONY : World/World.cpp.s

